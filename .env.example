# --- LLM provider ---------------------------------------------------------------
# Any OpenAI-compatible provider: innkube, gemini, openai, groq, openrouter,
# mistral, ollama, or custom. Each has a default endpoint and model (see
# config.yaml); the model must support tool calling.
LLM_PROVIDER=innkube

# API key for that provider — required. Never commit the real value.
#   gemini      https://aistudio.google.com/apikey
#   openai      https://platform.openai.com/api-keys
#   groq        https://console.groq.com/keys
#   openrouter  https://openrouter.ai/keys
#   mistral     https://console.mistral.ai/api-keys
#   ollama      needs no key, but this must not be empty: use "ollama"
LLM_API_KEY=your_api_key_here

# Optional overrides. Leave unset to use the provider's defaults. Required
# for LLM_PROVIDER=custom.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# LLM request timeout in seconds
LLM_TIMEOUT=600

# The old INNKUBE_API_KEY / INNKUBE_BASE_URL / INNKUBE_MODEL / INNKUBE_TIMEOUT
# names are still accepted, so an existing .env keeps working.

# Observability (Week 3). Env overrides config.yaml, same as everything else.
METRICS_ENABLED=true
METRICS_PORT=9091
TRACES_ENABLED=true
TRACES_DIRNAME=traces

# Trace export to Jaeger (ADR-095, ADR-111). Off unless set; `./run.sh
# --tracing` sets the first two for one session. Inside compose the endpoint
# defaults to http://jaeger:4318; OTLP_UI_URL is what your browser opens.
# OTLP_ENABLED=true
# OTLP_ENDPOINT=http://jaeger:4318
# OTLP_UI_URL=http://localhost:16686

# Token budget over a rolling 24-hour window that starts with the first
# charged call, not at midnight (ADR-088, ADR-089). Env overrides
# config.yaml here too, which is how a TA raises it without a config edit.
BUDGET_ENABLED=true
BUDGET_DAILY_TOKENS=1000000
