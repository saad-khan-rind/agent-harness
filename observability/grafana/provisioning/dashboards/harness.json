    {
      "type": "timeseries",
      "title": "Run duration p95",
      "description": "Wall-clock time from task to final answer, 95th percentile. The number the rest of this row exists to explain when it is high.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(harness_run_duration_seconds_bucket[$__rate_interval])) by (le, role))",
          "legendFormat": "{{role}}",
          "refId": "A"
        }
      ],
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      }
    },
    {
      "type": "timeseries",
      "title": "LLM request latency p95",
      "description": "Time InnKube took to answer one chat call. Usually most of a run's duration lives here, not in tool execution \u2014 check this before suspecting a tool.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(harness_llm_latency_seconds_bucket[$__rate_interval])) by (le, job))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      }
    },
    {
      "type": "timeseries",
      "title": "Tool latency p95 by kind",
      "description": "Time a tool call takes once the model has decided to make it, split by kind (builtin, mcp, memory, skill, delegate) so a slow MCP server does not hide inside an undifferentiated 'tools are slow'.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
