    {
      "type": "stat",
      "title": "Success ratio (1h)",
      "description": "Runs that reached a final answer, over all runs. capped and no_progress are the loop guards working, not errors, and are counted separately beside this. Note what this is NOT: it says nothing about whether the answer was right \u2014 that is row 11, and the gap between the two numbers is the most interesting thing on this dashboard.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(harness_runs_total{status=\"success\"}[1h])) / sum(increase(harness_runs_total[1h]))",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "id": 15,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
