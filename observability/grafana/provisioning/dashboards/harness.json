    {
      "type": "timeseries",
      "title": "MCP calls by server",
      "description": "'Which MCP server is responsible for a failure' as one query. The server was always recoverable from the tool-name prefix and was never readable; recording it as its own dimension makes it a legend entry. Safe as a label because server names come from config.yaml \u2014 bounded by a file somebody edits, not by what a model invents.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
